## quest_threshold
{{ quest_threshold_directive }}

{% if active_quests -%}
## active_quests
{% for q in active_quests %}- `{{ q.id }}` | {{ q.title }}
  objectives:
{% for o in (q.objectives or []) %}    {{ loop.index }}. [{% if o.done %}x{% elif o.failed %}f{% else %} {% endif %}] {{ o.description }}
{% endfor %}{% endfor %}
