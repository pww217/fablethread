    }
  ],
  "resolved_threads": [
    {
      "id": "existing_id",
      "resolution_state": "resolved|failed|abandoned",
      "outcome": "One sentence describing what happened."
    }
  ],
  "new_threads": [
    {
      "id": "new_unique_id",
      "summary": "Thread summary",
      "urgency": "normal",
      "dormant": false
    }
  ],
  "_checklist": {                // MANDATORY
    "thread_count": "Reviewed N active threads",
    "resolved": "N threads resolved or decayed",
    "new": "N new threads added",
    "goal": "Goal updated (why) OR confirmed current"
  }
}