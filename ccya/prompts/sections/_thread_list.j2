{# _thread_list.j2
   Required: threads (list[dict])
   Optional: turn_no (int) — for "X turns ago" display
   Emits: ### Active Threads / ### Dormant Threads headers
#}
{% if threads %}
### Active Threads ({{ threads | length }} active — target: 3-4, ~5 total)
{% for t in threads %}{% if not t.dormant %}{% set type_label = (t.type | default('unknown') | upper) ~ ' - ' ~ (t.urgency | default('normal') | upper) %}- `{{ t.id }}` [{{ type_label }}] {{ t.summary }}
{%- if t.last_updated_turn is not none %} ({{ turn_no - t.last_updated_turn }} turns ago){% endif %}
{%- for entry in t.progress %}
  - {{ entry }}
{%- endfor %}
{% endif %}{% endfor %}{% else %}No active threads.
{% endif %}
{% if threads | selectattr('dormant') | list %}
### Dormant Threads (faded but recoverable)
{% for t in threads %}{% if t.dormant %}{% set type_label = (t.type | default('unknown') | upper) ~ ' - ' ~ (t.urgency | default('background') | upper) %}- `{{ t.id }}` [{{ type_label }}] {{ t.summary }}{% if t.last_updated_turn is not none %} ({{ turn_no - t.last_updated_turn }} turns ago){% endif %}
{% endif %}{% endfor %}{% endif %}
