{# _world_state.j2
   Required: state (dict with scene.world_state)
   Optional: none — always renders (may be empty)
   Emits: no header (caller must provide one)
#}
{% for fact in (state.scene.world_state or []) %}{% if fact is mapping %}- [{% if fact.tier == "permanent" %}permanent{% else %}persistent{% endif %}] {{ fact.text }}
{% elif fact is string %}- {{ fact }}
{% endif -%}
{% endfor -%}
