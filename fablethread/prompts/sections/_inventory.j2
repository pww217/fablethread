{# _inventory.j2
   Required: none (renders "Nothing of note." if empty)
   Optional: inventory (list[dict]) — falls back to state.inventory
   Emits: ## Inventory header
#}
{% set inv = inventory -%}
{% if inv -%}
## Inventory
{% for item in inv -%}
{% set amt = item.get("amount") or 1 -%}
- **{{ item.get("name", item.get("id", "?")) }}**{% if amt > 1 or item.get("id") == "credits" %} ×{{ amt }}{% endif %}{% if item.get("notes") %}: {{ item.notes }}{% endif %}
{% endfor -%}
{%- else -%}
Nothing of note.
{% endif -%}
